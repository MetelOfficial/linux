#include <Wire.h>
#include <LiquidCrystal_I2C.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);

int pos = 0;
char nums[10] = "0123456789";
char buf[9] = "        ";

void setup() {
  lcd.init();
  lcd.backlight();
  pinMode(2, INPUT);
}
bool flag=1;
void loop() {
  int num = constrain(map(analogRead(A0), 0, 1000, 0, 9), 0, 9);
  
  lcd.setCursor(0, 0);
  lcd.print(num);
  
  lcd.setCursor(0, 1);
  for (int i = 0; i < 8; i++) {if (i != pos) lcd.print(buf[i]);}
   
  if (!digitalRead(2)) {
    if(flag){
    delay(50);
    buf[pos] = nums[num];
    pos++;
    if (pos > 8) {
      pos = 0;
      while(1);
    }
    flag=0;
  }
  } else {flag=1;}
}
